{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"array","minItems":1,"uniqueItems":true,
  "items":{"type":"object","additionalProperties":false,"required":["id","title","steps","expected","restoration"],"properties":{"id":{"pattern":"^(FZMT-[0-9]{2}|FZV2-RM-[0-9]{3}|FZCURRENT-[0-9]{3})$"},"title":{"type":"string","minLength":4},"category":{"enum":["settings","lifecycle","rendering","history","recovery","performance","privacy","current_contract"]},"risk":{"const":"safe_non_trading"},"priority":{"enum":["1 – Kritisch","2 – Hoch","3 – Mittel"]},"description":{"type":"string","minLength":10},"steps":{"type":"array","minItems":1,"items":{"type":"string","minLength":3}},"expected":{"type":"array","minItems":1,"items":{"type":"string","minLength":3}},"restoration":{"type":"string","minLength":3}},"allOf":[{"if":{"properties":{"id":{"pattern":"^FZMT-"}}},"then":{"required":["category","risk"]}},{"if":{"properties":{"id":{"pattern":"^(FZV2-RM|FZCURRENT)-"}}},"then":{"required":["priority","description"]}}]}
