    "state":{"const":"current_source_validated_runtime_pending"},
    "source_validated_suites":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["suite_id","state","requirements","golden_traces","manual_namespace"],"properties":{"suite_id":{"enum":["FZCP-v5","FZCP-v6"]},"state":{"const":"sourceValidatedRuntimePending"},"requirements":{"type":"string","pattern":"^FZ-[0-9]{3}\\.\\.FZ-[0-9]{3}$"},"golden_traces":{"type":"string","pattern":"^GT-[0-9]{3}\\.\\.GT-[0-9]{3}$"},"manual_namespace":{"pattern":"^FZCP-v[56]/MVA-[0-9]{2}\\.\\.MVA-[0-9]{2}$"}}}},
