{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panserk.github.io/quantower-documentation/schemas/fractal-zones-source-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "indicator_id", "indicator_generation", "source_state", "inventory", "setting_ids", "setting_facts", "line_option_ids", "action_ids", "visibility_branches", "conformance", "runtime_evidence", "sanitization", "setting_fact_digest", "contract_digest"],
  "properties": {
    "schema_version": {"const": "fz-public-source-contract-v3"},
    "indicator_id": {"const": "fractal-zones"},
    "indicator_generation": {"const": "Fractal Zones v2"},
    "source_state": {"const": "current_source_validated_v5_v6_runtime_pending"},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["product_setting_rows", "product_actions", "line_option_rows", "atomic_product_controls"], "properties": {"product_setting_rows": {"const": 56}, "product_actions": {"const": 2}, "line_option_rows": {"const": 7}, "atomic_product_controls": {"const": 70}}},
    "setting_ids": {"type": "array", "minItems": 56, "maxItems": 56, "uniqueItems": true, "items": {"pattern": "^[A-Za-z][A-Za-z0-9]+$"}},
    "setting_facts": {"type": "array", "minItems": 56, "maxItems": 56, "items": {"$ref": "#/$defs/setting"}},
    "line_option_ids": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"pattern": "^[A-Za-z][A-Za-z0-9]+$"}},
    "action_ids": {"type": "array", "prefixItems": [{"const": "VerifyFullHistoryNow"}, {"const": "CancelFullHistoryVerify"}], "items": false},
    "visibility_branches": {"type": "array", "minItems": 13, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "conformance": {"$ref": "#/$defs/conformance"},
    "runtime_evidence": {"type": "object", "additionalProperties": false, "required": ["historical_v1_to_v4", "v5", "v6", "tooltip_vs_engine_residual"], "properties": {"historical_v1_to_v4": {"const": "historical_runtime_evidence_retained"}, "v5": {"const": "sourceValidatedRuntimePending"}, "v6": {"const": "sourceValidatedRuntimePending"}, "tooltip_vs_engine_residual": {"enum": ["source_confirmed_runtime_ui_pending", "runtime_inventory_pending"]}}},
    "sanitization": {"$ref": "#/$defs/sanitization"},
    "setting_fact_digest": {"pattern": "^[0-9a-f]{64}$"},
    "contract_digest": {"pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "setting": {"type": "object", "additionalProperties": false, "required": ["id", "label", "group", "type", "default", "range_or_options", "visibility", "atomic_controls", "documentation_anchor"], "properties": {"id": {"pattern": "^[A-Za-z][A-Za-z0-9]+$"}, "label": {"type": "string", "minLength": 2}, "group": {"type": "string", "minLength": 3}, "type": {"enum": ["integer", "double", "selector", "boolean", "datetime", "line_options", "action", "color"]}, "default": {"type": ["string", "number", "boolean", "null"]}, "range_or_options": {"type": "string", "minLength": 1}, "visibility": {"type": "string", "minLength": 3}, "atomic_controls": {"type": "integer", "minimum": 1, "maximum": 3}, "documentation_anchor": {"pattern": "^setting-[a-z0-9-]+$"}}},
    "idRange": {"type": "object", "additionalProperties": false, "required": ["first", "last", "count"], "properties": {"first": {"type": "string"}, "last": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}},
    "suite": {"type": "object", "additionalProperties": false, "required": ["suite_id", "requirements", "golden_traces", "manual_acceptance", "runtime_state"], "properties": {"suite_id": {"enum": ["FZCP-v5", "FZCP-v6"]}, "requirements": {"$ref": "#/$defs/idRange"}, "golden_traces": {"$ref": "#/$defs/idRange"}, "manual_acceptance": {"type": "object", "additionalProperties": false, "required": ["namespace", "first", "last", "count"], "properties": {"namespace": {"pattern": "^FZCP-v[56]/MVA$"}, "first": {"pattern": "^MVA-[0-9]{2}$"}, "last": {"pattern": "^MVA-[0-9]{2}$"}, "count": {"type": "integer", "minimum": 1}}}, "runtime_state": {"const": "sourceValidatedRuntimePending"}}},
    "conformance": {"type": "object", "additionalProperties": false, "required": ["historical_v1_to_v4", "current_source_suites", "mva_namespace_rule"], "properties": {"historical_v1_to_v4": {"type": "object", "additionalProperties": false, "required": ["packs", "requirements", "golden_traces", "manual_acceptance", "runtime_state"], "properties": {"packs": {"const": ["v1", "v2", "v3", "v4"]}, "requirements": {"$ref": "#/$defs/idRange"}, "golden_traces": {"$ref": "#/$defs/idRange"}, "manual_acceptance": {"$ref": "#/$defs/idRange"}, "runtime_state": {"const": "historical_runtime_evidence_retained"}}}, "current_source_suites": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/suite"}}, "mva_namespace_rule": {"const": "suite_qualified"}}},
    "sanitization": {"type": "object", "additionalProperties": false, "required": ["private_paths", "private_repository_metadata", "private_source_text", "raw_source_hashes", "raw_logs", "sensitive_runtime_data"], "properties": {"private_paths": {"const": false}, "private_repository_metadata": {"const": false}, "private_source_text": {"const": false}, "raw_source_hashes": {"const": false}, "raw_logs": {"const": false}, "sensitive_runtime_data": {"const": false}}}
  }
}
