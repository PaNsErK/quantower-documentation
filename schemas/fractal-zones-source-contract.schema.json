{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://panserk.github.io/quantower-documentation/schemas/fractal-zones-source-contract.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","indicator_id","indicator_generation","source_state","inventory","setting_ids","line_option_ids","action_ids","visibility_branches","conformance","runtime_acceptance","sanitization","setting_fact_digest","contract_digest"],
  "properties":{
    "schema_version":{"const":"fz-public-source-contract-v2"},
    "indicator_id":{"const":"fractal-zones"},
    "indicator_generation":{"const":"Fractal Zones v2"},
    "source_state":{"const":"current_merged_product_source_runtime_validated"},
    "inventory":{"type":"object","additionalProperties":false,"required":["product_setting_rows","product_actions","line_option_rows","atomic_product_controls"],"properties":{"product_setting_rows":{"const":56},"product_actions":{"const":2},"line_option_rows":{"const":7},"atomic_product_controls":{"const":70}}},
    "setting_ids":{"type":"array","minItems":56,"maxItems":56,"uniqueItems":true,"items":{"pattern":"^[A-Za-z][A-Za-z0-9]+$"}},
    "line_option_ids":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"pattern":"^[A-Za-z][A-Za-z0-9]+$"}},
    "action_ids":{"type":"array","prefixItems":[{"const":"VerifyFullHistoryNow"},{"const":"CancelFullHistoryVerify"}],"items":false},
    "visibility_branches":{"type":"array","minItems":11,"maxItems":11,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "conformance":{"type":"object","additionalProperties":false,"required":["packs","requirements","golden_traces","manual_acceptance"],"properties":{"packs":{"const":["v1","v2","v3","v4"]},"requirements":{"$ref":"#/$defs/idRange"},"golden_traces":{"$ref":"#/$defs/idRange"},"manual_acceptance":{"$ref":"#/$defs/idRange"}}},
    "runtime_acceptance":{"type":"object","additionalProperties":false,"required":["state","manual_acceptance_complete","user_evaluation","evidence_document"],"properties":{"state":{"const":"terminal_technical_acceptance_with_nonblocking_warning"},"manual_acceptance_complete":{"const":false},"user_evaluation":{"const":"pending_user_evaluation"},"evidence_document":{"const":"fractal-zones-runtime-acceptance.json"}}},
    "sanitization":{"type":"object","additionalProperties":false,"required":["private_paths","private_repository_metadata","private_source_text","raw_source_hashes","raw_logs","sensitive_runtime_data"],"properties":{"private_paths":{"const":false},"private_repository_metadata":{"const":false},"private_source_text":{"const":false},"raw_source_hashes":{"const":false},"raw_logs":{"const":false},"sensitive_runtime_data":{"const":false}}},
    "setting_fact_digest":{"pattern":"^[0-9a-f]{64}$"},"contract_digest":{"pattern":"^[0-9a-f]{64}$"}
  },
  "$defs":{"idRange":{"type":"object","additionalProperties":false,"required":["first","last","count"],"properties":{"first":{"type":"string"},"last":{"type":"string"},"count":{"type":"integer","minimum":1}}}}
}
