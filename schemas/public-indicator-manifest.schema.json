{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panserk.github.io/quantower-documentation/schemas/public-indicator-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publication", "source_contract", "indicator", "inventory", "runtime_acceptance", "pages", "settings", "base_settings", "test_suites", "conformance", "privacy"],
  "properties": {
    "schema_version": {"const": "fz-public-manifest-v3"},
    "publication": {"type": "object", "additionalProperties": false, "required": ["status", "manual_acceptance_complete", "runtime_acceptance_complete", "user_evaluation", "official_affiliation", "content_license_state"], "properties": {"status": {"const": "public_beta_user_evaluation_pending"}, "manual_acceptance_complete": {"const": false}, "runtime_acceptance_complete": {"const": false}, "user_evaluation": {"const": "pending_user_evaluation"}, "official_affiliation": {"const": false}, "content_license_state": {"const": "no_open_source_license"}}},
    "source_contract": {"type": "object", "additionalProperties": false, "required": ["status", "schema_version", "validation_mode", "setting_fact_digest", "contract_digest"], "properties": {"status": {"const": "current_source_validated_v5_v6_runtime_pending"}, "schema_version": {"const": "fz-public-source-contract-v3"}, "validation_mode": {"const": "sanitized_inventory_or_contract_only"}, "setting_fact_digest": {"pattern": "^[0-9a-f]{64}$"}, "contract_digest": {"pattern": "^[0-9a-f]{64}$"}}},
    "indicator": {"type": "object", "additionalProperties": false, "required": ["id", "name", "generation", "product_kind", "trading_capability", "version_state", "version_ui_state", "help_link_state", "documentation_route"], "properties": {"id": {"const": "fractal-zones"}, "name": {"const": "Fractal Zones"}, "generation": {"const": "Fractal Zones v2"}, "product_kind": {"const": "non-trading-indicator"}, "trading_capability": {"const": false}, "version_state": {"const": "current_source_validated_runtime_inventory_pending"}, "version_ui_state": {"const": "not_captured_in_sanitized_evidence"}, "help_link_state": {"const": "confirmed_disabled_current_host_context_not_executed"}, "documentation_route": {"const": "/indicators/fractal-zones/"}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["product_owned_setting_rows", "product_owned_actions", "line_option_rows", "atomic_product_controls", "inherited_setting_rows", "inherited_atomic_controls", "maximum_total_setting_rows", "maximum_total_atomic_controls", "base_settings_union", "base_settings_observed_businesslayer", "full_current_host_inventory_claim"], "properties": {"product_owned_setting_rows": {"const": 56}, "product_owned_actions": {"const": 2}, "line_option_rows": {"const": 7}, "atomic_product_controls": {"const": 70}, "inherited_setting_rows": {"const": 11}, "inherited_atomic_controls": {"const": 25}, "maximum_total_setting_rows": {"const": 67}, "maximum_total_atomic_controls": {"const": 95}, "base_settings_union": {"const": "not_captured_in_sanitized_evidence_historical_observation_retained"}, "base_settings_observed_businesslayer": {"const": "1.146.17.0"}, "full_current_host_inventory_claim": {"const": false}}},
    "runtime_acceptance": {"type": "object", "additionalProperties": false, "required": ["state", "historical_evidence_document", "current_source_suites", "runtime_ui_inventory_state", "user_evaluation"], "properties": {"state": {"const": "historical_v1_to_v4_retained_current_v5_v6_runtime_pending"}, "historical_evidence_document": {"const": "fractal-zones-runtime-acceptance.json"}, "current_source_suites": {"type": "array", "const": ["FZCP-v5", "FZCP-v6"]}, "runtime_ui_inventory_state": {"const": "runtime_inventory_partial_confirmed_with_residuals"}, "user_evaluation": {"const": "pending_user_evaluation"}}},
    "pages": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/page"}},
    "settings": {"type": "array", "minItems": 56, "maxItems": 56, "items": {"$ref": "#/$defs/setting"}},
    "base_settings": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/baseSetting"}},
    "test_suites": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/testSuite"}},
    "conformance": {"type": "object", "additionalProperties": false, "required": ["historical_v1_to_v4", "current_source_suites", "mva_namespace_rule"], "properties": {"historical_v1_to_v4": {"$ref": "#/$defs/historical"}, "current_source_suites": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/currentSuite"}}, "mva_namespace_rule": {"const": "suite_qualified"}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["absolute_paths_persisted", "source_text_persisted", "repository_metadata_persisted", "raw_source_hashes_persisted", "sensitive_runtime_data_persisted", "analytics_or_telemetry", "runtime_network_api"], "properties": {"absolute_paths_persisted": {"const": false}, "source_text_persisted": {"const": false}, "repository_metadata_persisted": {"const": false}, "raw_source_hashes_persisted": {"const": false}, "sensitive_runtime_data_persisted": {"const": false}, "analytics_or_telemetry": {"const": false}, "runtime_network_api": {"const": false}}}
  },
  "$defs": {
    "page": {"type": "object", "additionalProperties": false, "required": ["id", "title", "page", "mode"], "properties": {"id": {"pattern": "^FZT-[0-9]{2}$"}, "title": {"type": "string", "minLength": 3}, "page": {"pattern": "^indicators/fractal-zones/.+\\.md$"}, "mode": {"enum": ["understand", "configure", "learn", "test", "troubleshoot", "reference"]}}},
    "setting": {"type": "object", "additionalProperties": false, "required": ["id", "label", "group", "type", "default", "range_or_options", "visibility", "atomic_controls", "documentation_anchor"], "properties": {"id": {"pattern": "^[A-Za-z][A-Za-z0-9]+$"}, "label": {"type": "string", "minLength": 2}, "group": {"type": "string", "minLength": 3}, "type": {"enum": ["integer", "double", "selector", "boolean", "datetime", "line_options", "action", "color"]}, "default": {"type": ["string", "number", "boolean", "null"]}, "range_or_options": {"type": "string", "minLength": 1}, "visibility": {"type": "string", "minLength": 3}, "atomic_controls": {"type": "integer", "minimum": 1, "maximum": 3}, "documentation_anchor": {"pattern": "^setting-[a-z0-9-]+$"}}},
    "baseSetting": {"type": "object", "additionalProperties": false, "required": ["id", "label", "group", "type", "observed_value", "range_or_options", "atomic_controls"], "properties": {"id": {"pattern": "^Base[A-Za-z0-9]+$"}, "label": {"type": "string"}, "group": {"enum": ["VIEW", "TIMEFRAME VISIBILITY", "BASE"]}, "type": {"enum": ["selector", "boolean", "timeframe_range", "action"]}, "observed_value": {"type": ["string", "boolean"]}, "range_or_options": {"type": "string"}, "atomic_controls": {"type": "integer", "minimum": 1, "maximum": 3}}},
    "testSuite": {"type": "object", "additionalProperties": false, "required": ["suite_id", "title", "catalog", "count", "state"], "properties": {"suite_id": {"enum": ["FZMT", "FZV2-RM", "FZCURRENT"]}, "title": {"type": "string"}, "catalog": {"pattern": "^includes/.+\\.json$"}, "count": {"type": "integer", "minimum": 1}, "state": {"enum": ["available_local_only", "historical_pending_user_evaluation", "current_source_validated_runtime_pending"]}}},
    "idRange": {"type": "object", "additionalProperties": false, "required": ["first", "last", "count"], "properties": {"first": {"type": "string"}, "last": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}},
    "historical": {"type": "object", "additionalProperties": false, "required": ["packs", "requirements", "golden_traces", "manual_acceptance", "runtime_state"], "properties": {"packs": {"const": ["v1", "v2", "v3", "v4"]}, "requirements": {"$ref": "#/$defs/idRange"}, "golden_traces": {"$ref": "#/$defs/idRange"}, "manual_acceptance": {"$ref": "#/$defs/idRange"}, "runtime_state": {"const": "historical_runtime_evidence_retained"}}},
    "currentSuite": {"type": "object", "additionalProperties": false, "required": ["suite_id", "requirements", "golden_traces", "manual_acceptance", "runtime_state"], "properties": {"suite_id": {"enum": ["FZCP-v5", "FZCP-v6"]}, "requirements": {"$ref": "#/$defs/idRange"}, "golden_traces": {"$ref": "#/$defs/idRange"}, "manual_acceptance": {"type": "object", "additionalProperties": false, "required": ["namespace", "first", "last", "count"], "properties": {"namespace": {"pattern": "^FZCP-v[56]/MVA$"}, "first": {"pattern": "^MVA-[0-9]{2}$"}, "last": {"pattern": "^MVA-[0-9]{2}$"}, "count": {"type": "integer", "minimum": 1}}}, "runtime_state": {"const": "sourceValidatedRuntimePending"}}}
  }
}
