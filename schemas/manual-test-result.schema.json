{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panserk.github.io/quantower-documentation/schemas/manual-test-result.schema.json",
  "title": "Fractal Zones local manual test result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "indicator_id", "indicator_version_state", "exported_at_utc", "notes_included", "results"],
  "properties": {
    "schema_version": {"const": "fz-manual-test-result-v1"},
    "indicator_id": {"const": "fractal-zones"},
    "indicator_version_state": {"const": "runtime_inventory_pending"},
    "exported_at_utc": {"type": "string", "format": "date-time"},
    "notes_included": {"type": "boolean"},
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "status"],
        "properties": {
          "test_id": {"pattern": "^FZMT-[0-9]{2}$"},
          "status": {"enum": ["open", "pass", "fail", "blocked"]},
          "note": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
