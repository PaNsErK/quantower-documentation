{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","indicator_id","indicator_version_state","suite_id","exported_at_utc","notes_included","results"],
  "properties":{"schema_version":{"enum":["fz-manual-test-result-v2","fz-manual-test-result-v3"]},"indicator_id":{"const":"fractal-zones"},"indicator_version_state":{"enum":["current_merged_runtime_validated_build_not_publicly_versioned","current_source_validated_runtime_inventory_pending"]},"suite_id":{"enum":["FZMT","FZV2-RM","FZCURRENT"]},"exported_at_utc":{"type":"string","format":"date-time"},"notes_included":{"type":"boolean"},"results":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["test_id","status"],"properties":{"test_id":{"pattern":"^(FZMT-[0-9]{2}|FZV2-RM-[0-9]{3}|FZCURRENT-[0-9]{3})$"},"status":{"enum":["open","pass","fail","blocked","improvement"]},"note":{"type":"string","maxLength":1000}}}}},
  "allOf":[
    {"if":{"properties":{"suite_id":{"const":"FZMT"}}},"then":{"properties":{"results":{"items":{"properties":{"test_id":{"pattern":"^FZMT-[0-9]{2}$"}}}}}}},
    {"if":{"properties":{"suite_id":{"const":"FZV2-RM"}}},"then":{"properties":{"results":{"items":{"properties":{"test_id":{"pattern":"^FZV2-RM-[0-9]{3}$"}}}}}}},
    {"if":{"properties":{"suite_id":{"const":"FZCURRENT"}}},"then":{"properties":{"schema_version":{"const":"fz-manual-test-result-v3"},"indicator_version_state":{"const":"current_source_validated_runtime_inventory_pending"},"results":{"items":{"properties":{"test_id":{"pattern":"^FZCURRENT-[0-9]{3}$"}}}}}}}
  ]
}
